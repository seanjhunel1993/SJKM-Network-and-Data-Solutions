            <script>
            function testAcs(btn) {
                var out = document.getElementById('acsTestResult');
                out.textContent = 'Testing…'; out.style.color = 'var(--text-muted)';
                btn.disabled = true;
                fetch('https://sjkmdatalink.isproph.com/admin/genieacs/test-connection', {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': 'IrT5vTPqAVbkV7OP8qu1UCDMZT1E1Y17pxcG0vZ3', 'Accept': 'application/json' }
                }).then(function (r) { return r.json(); }).then(function (d) {
                    out.textContent = d.message;
                    out.style.color = d.ok ? 'var(--success,#2ea44f)' : 'var(--danger,#d33)';
                }).catch(function () { out.textContent = 'Test failed.'; out.style.color = 'var(--danger,#d33)'; })
                  .finally(function () { btn.disabled = false; });
            }
            </script>
