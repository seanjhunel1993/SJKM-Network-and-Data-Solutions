            'sticky-note':'sticky-note','hard-drive':'hard-drive','headset':'headset','clipboard-list':'clipboard-list',
            'comment-sms':'message-square-text','draw-polygon':'shapes'
        };
        var SKIP = {'spin':1,'pulse':1,'fw':1,'lg':1,'2x':1,'3x':1,'xs':1,'sm':1,'fa':1,'fas':1,'far':1,'fab':1,'fal':1};
        function convert(root) {
            (root || document).querySelectorAll('i[class*="fa-"]').forEach(function (el) {
                if (el.hasAttribute('data-lucide')) return;
                var cls = el.getAttribute('class') || '';
                var spin = /\bfa-spin\b/.test(cls);
                var tokens = cls.split(/\s+/);
                var name = null;
                for (var i = 0; i < tokens.length; i++) {
                    if (tokens[i].indexOf('fa-') === 0) {
                        var n = tokens[i].slice(3);
                        if (!SKIP[n]) { name = n; break; }
                    }
                }
                if (!name || !MAP[name]) return; // unmapped / brand icons keep Font Awesome
                el.setAttribute('data-lucide', MAP[name]);
                var kept = tokens.filter(function (c) { return c && c.indexOf('fa-') !== 0 && !SKIP[c]; });
                if (spin) kept.push('lucide-spin');
                if (kept.length) el.setAttribute('class', kept.join(' ')); else el.removeAttribute('class');
            });
            if (window.lucide && lucide.createIcons) {
                lucide.createIcons({ attrs: { width: '1em', height: '1em', 'stroke-width': 2 } });
            }
        }
        window.refreshIcons = convert;
        // Swap an already-rendered icon (Font Awesome <i> or Lucide <svg>) to another icon.
        window.swapIcon = function (ref, faName) {
            if (!ref) return;
            var el = (ref.matches && ref.matches('i, svg')) ? ref : (ref.querySelector ? ref.querySelector('i, svg') : null);
            if (!el) return;
            var repl = document.createElement('i');
            repl.className = 'fas fa-' + faName;
            if (el.id) repl.id = el.id;
            var st = el.getAttribute('style'); if (st) repl.setAttribute('style', st);
            el.replaceWith(repl);
            convert(document);
        };
        function boot() {
            convert(document);
            new MutationObserver(function (muts) {
                for (var i = 0; i < muts.length; i++) {
                    var an = muts[i].addedNodes;
                    for (var j = 0; j < an.length; j++) {
                        var nd = an[j];
                        if (nd.nodeType === 1 && ((nd.matches && nd.matches('i[class*="fa-"]')) || (nd.querySelector && nd.querySelector('i[class*="fa-"]')))) {
                            convert(document); return;
                        }
                    }
                }
            }).observe(document.body, { childList: true, subtree: true });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
        else boot();
    })();
    </script>
    <script>
function toggleBankRow(btn) {
    var row = btn.closest('tr.bank-row');
    if (!row) return;
    var open = row.classList.toggle('expanded');
    var icon = btn.querySelector('i');
    if (window.swapIcon) window.swapIcon(btn, open ? 'minus' : 'plus');
    btn.setAttribute('aria-label', open ? 'Hide details' : 'Show details');
}
function toggleEmpRow(btn) {
    var row = btn.closest('tr.emp-row');
    if (!row) return;
    var open = row.classList.toggle('expanded');
    var icon = btn.querySelector('i');
    if (window.swapIcon) window.swapIcon(btn, open ? 'minus' : 'plus');
    btn.setAttribute('aria-label', open ? 'Hide details' : 'Show details');
}
function showSection(id, el) {
    document.querySelectorAll('.settings-section').forEach(function(s) { s.style.display = 'none'; });
    document.querySelectorAll('.settings-nav-item').forEach(function(a) { a.classList.remove('active'); });
    document.getElementById('section-' + id).style.display = '';
    el.classList.add('active');
    history.replaceState(null, '', '#' + id);
}
(function() {
    var saved = sessionStorage.getItem('settingsSection');
    if (saved) { sessionStorage.removeItem('settingsSection'); }
    var target = saved || location.hash.replace('#','');
    if (target) {
        var el = document.querySelector('[data-section="' + target + '"]');
        if (el) showSection(target, el);
    }
})();
// Remember the open section across the save redirect (POST -> redirect -> GET).
document.addEventListener('submit', function () {
    var active = document.querySelector('.settings-nav-item.active');
    if (active && active.dataset.section) {
        sessionStorage.setItem('settingsSection', active.dataset.section);
    }
}, true);
function openBankModal() { document.getElementById('bankModal').classList.add('open'); }
function closeBankModal() { document.getElementById('bankModal').classList.remove('open'); }
// Close modal on overlay click
document.getElementById('bankModal').addEventListener('click', function(e) {
    if (e.target === this) closeBankModal();
});
// Re-open modal + Banks section if a bank field failed validation

function setEmployeePasswordRequired(req) {
    var pw = document.getElementById('employee_password');
    var pwc = document.getElementById('employee_password_confirmation');
    pw.required = req; pwc.required = req;
    document.getElementById('employee_pw_req').style.display = req ? '' : 'none';
    document.getElementById('employee_pw_req2').style.display = req ? '' : 'none';
    document.getElementById('employee_pw_hint').style.display = req ? 'none' : 'block';
}
function applyEmployeeCreateMode() {
    var f = document.getElementById('employeeForm');
    f.setAttribute('action', 'https://sjkmdatalink.isproph.com/admin/settings/employees');
    document.getElementById('employee_method').value = '';
    document.getElementById('employee_edit_id').value = '';
    document.getElementById('employeeModalTitle').innerHTML = '<i class="fas fa-user-tie" style="color:var(--primary)"></i> Add Employee';
    document.getElementById('employeeSubmitBtn').innerHTML = '<i class="fas fa-save"></i> Save Employee';
    setEmployeePasswordRequired(true);
}
function applyEmployeeEditMode(actionUrl, id) {
    var f = document.getElementById('employeeForm');
    f.setAttribute('action', actionUrl);
    document.getElementById('employee_method').value = 'PUT';
    document.getElementById('employee_edit_id').value = id || '';
    document.getElementById('employeeModalTitle').innerHTML = '<i class="fas fa-user-tie" style="color:var(--primary)"></i> Edit Employee';
    document.getElementById('employeeSubmitBtn').innerHTML = '<i class="fas fa-save"></i> Update Employee';
    setEmployeePasswordRequired(false);
}
// "Add Employee" button — clean create form
function openEmployeeModal() {
    document.getElementById('employeeForm').reset();
    applyEmployeeCreateMode();
    document.getElementById('employeeModal').classList.add('open');
}
function openEmployeeEdit(btn) {
    closeAllRowMenus();
    var d = btn.dataset;
    document.getElementById('employeeForm').reset();
    document.getElementById('employee_name').value = d.name || '';
    document.getElementById('employee_email').value = d.email || '';
    document.getElementById('employee_role').value = d.role || '';
    document.getElementById('employee_address').value = d.address || '';
    document.getElementById('employee_login').value = d.login || '1';
    document.getElementById('employee_gender').value = d.gender || '';
    document.getElementById('employee_phone').value = d.phone || '';
    document.getElementById('employee_dob').value = d.dob || '';
    document.getElementById('employee_join').value = d.join || '';
    applyEmployeeEditMode(d.action, d.action.split('/').pop());
    document.getElementById('employeeModal').classList.add('open');
}
function closeEmployeeModal() { document.getElementById('employeeModal').classList.remove('open'); }

// Row action dropdown menus (positioned fixed so they escape the table's overflow)
function toggleRowMenu(btn) {
    var menu = btn.parentElement.querySelector('.row-menu-dropdown');
    var wasOpen = menu.classList.contains('open');
    closeAllRowMenus();
    if (wasOpen) return;
    var r = btn.getBoundingClientRect();
    menu.style.top = ((r.bottom + 4 + menu.offsetHeight > window.innerHeight - 8) ? Math.max(8, r.top - menu.offsetHeight - 4) : (r.bottom + 4)) + 'px';
    menu.classList.add('open');
    var left = r.right - menu.offsetWidth;
    if (left < 8) left = 8;
    menu.style.left = left + 'px';
    btn.setAttribute('aria-expanded', 'true');
}
function closeAllRowMenus() {
    document.querySelectorAll('.row-menu-dropdown.open').forEach(function(m){ m.classList.remove('open'); });
    document.querySelectorAll('.row-menu-btn[aria-expanded="true"]').forEach(function(b){ b.setAttribute('aria-expanded', 'false'); });
}
document.addEventListener('click', function(e){ if (!e.target.closest('.row-menu')) closeAllRowMenus(); });
window.addEventListener('scroll', closeAllRowMenus, true);
window.addEventListener('resize', closeAllRowMenus);
document.getElementById('employeeModal').addEventListener('click', function(e) {
    if (e.target === this) closeEmployeeModal();
});
// Re-open modal + Employees section if an employee field failed validation

function openRoleModal() {
    // Create mode — reset the form
    document.getElementById('roleModalTitle').innerHTML = '<i class="fas fa-user-shield" style="color:var(--primary)"></i> Add Role';
    document.getElementById('roleForm').setAttribute('action', 'https://sjkmdatalink.isproph.com/admin/settings/roles');
    document.getElementById('role_method').value = '';
    document.getElementById('role_name_input').value = '';
    document.querySelectorAll('.role-perm').forEach(function(cb){ cb.checked = false; });
    document.getElementById('roleSubmitBtn').innerHTML = '<i class="fas fa-save"></i> Save Role';
    document.getElementById('roleModal').classList.add('open');
}
function openRoleEdit(btn) {
    var d = btn.dataset;
    document.getElementById('roleModalTitle').innerHTML = '<i class="fas fa-user-shield" style="color:var(--primary)"></i> Edit Role';
    document.getElementById('roleForm').setAttribute('action', d.action);
    document.getElementById('role_method').value = 'PUT';
    document.getElementById('role_name_input').value = d.name;
    var perms = [];
    try { perms = JSON.parse(d.permissions || '[]'); } catch (e) {}
    document.querySelectorAll('.role-perm').forEach(function(cb){ cb.checked = perms.indexOf(cb.value) !== -1; });
    document.getElementById('roleSubmitBtn').innerHTML = '<i class="fas fa-save"></i> Update Role';
    document.getElementById('roleModal').classList.add('open');
}
function closeRoleModal() { document.getElementById('roleModal').classList.remove('open'); }
document.getElementById('roleModal').addEventListener('click', function(e) {
    if (e.target === this) closeRoleModal();
});
// Re-open modal + Roles section if a role field failed validation (keeps old() values)
</script>
<script>
function toggleIsolate() {
    var on = document.getElementById('auto_isolate').checked;
    document.getElementById('isolate-options').style.display = on ? 'block' : 'none';
}
</script>
<script>
function toggleField(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon  = document.getElementById(iconId);
    input.type  = input.type === 'password' ? 'text' : 'password';
    if (window.swapIcon) window.swapIcon(icon, input.type === 'password' ? 'eye' : 'eye-slash');
}
function copyField(elId, btnId) {
    const el  = document.getElementById(elId);
    const val = el.value !== undefined ? el.value : el.textContent.trim();
    navigator.clipboard.writeText(val).then(function () {
        const btn = document.getElementById(btnId);
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
        setTimeout(function () { btn.innerHTML = orig; }, 2000);
    });
}
function testPaymentConnection() {
    const btn   = document.getElementById('testBtn');
    const badge = document.getElementById('connectionBadge');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Testing...';
    badge.style.display = 'none';
    fetch('https://sjkmdatalink.isproph.com/admin/settings/payment/test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content },
    })
    .then(r => r.json())
    .then(data => {
        badge.style.display = 'inline-flex';
        badge.className = 'badge ' + (data.ok ? 'badge-success' : 'badge-danger');
        badge.innerHTML = '<i class="fas fa-' + (data.ok ? 'check-circle' : 'times-circle') + '"></i> ' + data.message;
    })
    .catch(() => {
        badge.style.display = 'inline-flex';
        badge.className = 'badge badge-danger';
        badge.innerHTML = '<i class="fas fa-times-circle"></i> Request failed';
    })
    .finally(() => {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-plug"></i> Test Connection';
    });
}
</script>
    
                    
            <style>
    .support-fab { position: fixed; right: 24px; bottom: 24px; z-index: 90; display: flex; align-items: center; }
    .support-fab-btn { width: 58px; height: 58px; border-radius: 50%; background: linear-gradient(135deg,#6366f1,#8b5cf6);
        color: #fff; display: flex; align-items: center; justify-content: center; font-size: 23px; text-decoration: none;
        box-shadow: 0 10px 26px rgba(99,102,241,.45); transition: transform .18s ease, box-shadow .18s ease; position: relative; }
    .support-fab-btn:hover { transform: translateY(-3px) scale(1.04); box-shadow: 0 14px 32px rgba(99,102,241,.55); }
    .support-fab-btn:active { transform: scale(.97); }
    .support-fab-label { position: absolute; right: 70px; white-space: nowrap; background: #1e293b; color: #fff;
        font-size: 13px; font-weight: 600; padding: 8px 12px; border-radius: 9px; opacity: 0; pointer-events: none;
        transform: translateX(6px); transition: opacity .18s ease, transform .18s ease; box-shadow: 0 6px 18px rgba(0,0,0,.2); }
    .support-fab-label::after { content: ''; position: absolute; right: -5px; top: 50%; transform: translateY(-50%);
        border-left: 6px solid #1e293b; border-top: 6px solid transparent; border-bottom: 6px solid transparent; }
    .support-fab:hover .support-fab-label { opacity: 1; transform: translateX(0); }
    .support-fab-badge { position: absolute; top: -3px; right: -3px; min-width: 20px; height: 20px; padding: 0 6px;
        background: #ef4444; color: #fff; border: 2px solid var(--bg,#f1f5f9); border-radius: 10px; font-size: 11px;
        font-weight: 700; display: none; align-items: center; justify-content: center; line-height: 1; }
    @media (max-width: 640px) {
        .support-fab { right: 16px; bottom: 16px; }
        .support-fab-btn { width: 52px; height: 52px; font-size: 21px; }
        .support-fab-label { display: none; }
    }
</style>
<div class="support-fab">
    <a href="https://sjkmdatalink.isproph.com/admin/support" class="support-fab-btn" aria-label="Chat with iSPRO PH">
        <span class="support-fab-label">Chat with iSPRO PH</span>
        <i class="fas fa-comment-dots"></i>
        <span class="support-fab-badge" id="supportFabBadge"></span>
    </a>
</div>
<script>
(function () {
    var badge = document.getElementById('supportFabBadge');
    if (!badge) return;
    function update() {
        fetch('https://sjkmdatalink.isproph.com/admin/support/unread', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
                if (!d) return;
                if (d.count > 0) { badge.textContent = d.count > 99 ? '99+' : d.count; badge.style.display = 'flex'; }
                else { badge.style.display = 'none'; }
            })
            .catch(function () {});
    }
    update();
    setInterval(function () { if (document.visibilityState !== 'hidden') update(); }, 10000);
})();
</script>
    </body>
</html>
