<script>
(function(){
    var b=document.getElementById('tenantSupportBadge'); if(!b) return;
    function u(){ fetch('https://sjkmdatalink.isproph.com/admin/support/unread',{headers:{'X-Requested-With':'XMLHttpRequest'}})
        .then(function(r){return r.ok?r.json():null;})
        .then(function(d){ if(!d)return; if(d.count>0){b.textContent=d.count;b.style.display='';}else{b.style.display='none';} })
        .catch(function(){}); }
    u(); setInterval(function(){ if(document.visibilityState!=='hidden') u(); },10000);
})();
</script>
