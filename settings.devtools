            <div id="dbRestoreModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.55);align-items:center;justify-content:center;padding:16px">
                <div style="background:#fff;border-radius:14px;width:100%;max-width:500px;box-shadow:0 20px 60px rgba(0,0,0,.3)">
                    <div style="background:#fef2f2;border-radius:14px 14px 0 0;padding:18px 22px;border-bottom:1px solid #fecaca;display:flex;align-items:center;gap:12px">
                        <div style="width:40px;height:40px;background:#fee2e2;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0"><i class="fas fa-exclamation-triangle" style="color:#dc2626"></i></div>
                        <div><div style="font-size:16px;font-weight:700;color:#991b1b">Restore Database</div><div style="font-size:12px;color:#b91c1c">This overwrites your current data</div></div>
                    </div>
                    <div style="padding:20px 22px">
                        <div style="background:#fef2f2;border:1px solid #fca5a5;border-radius:8px;padding:12px 14px;margin-bottom:16px;font-size:13px;color:#7f1d1d;line-height:1.6"><strong>Warning:</strong> Restoring replaces your entire database with this backup. All changes made after the backup date will be permanently lost.</div>
                        <div style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;margin-bottom:6px">Backup file</div>
                        <div id="dbRestoreName" style="font-family:monospace;font-size:12.5px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:8px 12px;word-break:break-all;margin-bottom:16px"></div>
                        <label style="font-size:13px;font-weight:600;color:#374151;display:block;margin-bottom:6px">Type <span style="font-family:monospace;color:#dc2626;background:#fef2f2;padding:1px 5px;border-radius:4px">RESTORE</span> to confirm:</label>
                        <input type="text" id="dbRestoreInput" class="form-control" placeholder="RESTORE" oninput="dbCheckRestore()" autocomplete="off">
                        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:18px">
                            <button type="button" class="btn btn-secondary" onclick="closeDbRestore()">Cancel</button>
                            <form id="dbRestoreForm" method="POST"><input type="hidden" name="_token" value="IrT5vTPqAVbkV7OP8qu1UCDMZT1E1Y17pxcG0vZ3" autocomplete="off">                                <button type="submit" id="dbRestoreBtn" class="btn btn-danger" disabled style="opacity:.5"><i class="fas fa-undo-alt"></i> Restore</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <script>
            function openDbRestore(name, action) {
                document.getElementById('dbRestoreName').textContent = name;
                document.getElementById('dbRestoreForm').action = action;
                var i = document.getElementById('dbRestoreInput'); i.value = '';
                var b = document.getElementById('dbRestoreBtn'); b.disabled = true; b.style.opacity = '.5';
                document.getElementById('dbRestoreModal').style.display = 'flex';
            }
            function closeDbRestore() { document.getElementById('dbRestoreModal').style.display = 'none'; }
            function dbCheckRestore() {
                var ok = document.getElementById('dbRestoreInput').value.trim() === 'RESTORE';
                var b = document.getElementById('dbRestoreBtn'); b.disabled = !ok; b.style.opacity = ok ? '1' : '.5';
            }
            document.getElementById('dbRestoreModal').addEventListener('click', function(e){ if (e.target === this) closeDbRestore(); });
            function bkToggle(e, btn){
                e.stopPropagation();
                var m = btn.closest('.bkmenu');
                var dd = m.querySelector('.bkmenu-dd');
                var wasOpen = m.classList.contains('open');
                document.querySelectorAll('.bkmenu.open').forEach(function(x){ x.classList.remove('open'); });
                if (wasOpen) return;
                m.classList.add('open');
                var r = btn.getBoundingClientRect();
                var ddH = dd.offsetHeight; var top = r.bottom + 6; if (top + ddH > window.innerHeight - 8) { top = Math.max(8, r.top - ddH - 6); } dd.style.top = top + 'px';
                var left = r.right - dd.offsetWidth;
                if (left < 8) left = 8;
                dd.style.left = left + 'px';
            }
            document.addEventListener('click', function(){ document.querySelectorAll('.bkmenu.open').forEach(function(x){ x.classList.remove('open'); }); });
            window.addEventListener('resize', function(){ document.querySelectorAll('.bkmenu.open').forEach(function(x){ x.classList.remove('open'); }); });
            </script>
        </div>
    </div>
</div>


