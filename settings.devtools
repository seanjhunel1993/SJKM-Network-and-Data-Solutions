.nav-count { margin-left: auto; font-size: 11px; font-weight: 700; background: rgba(148,163,184,.22); color: var(--sidebar-text); padding: 1px 8px; border-radius: 10px; line-height: 1.5; }
body.sidebar-collapsed .nav-count { display: none; }
/* Not-yet-released menu entry: inert, with the label and icon dimmed so it reads as
   "coming" rather than "broken". cursor:default rather than not-allowed — this is "not
   ready", not "you are forbidden", which is what the suspended-subscription styling
   further down already means.

   Greyed by colour, NOT by opacity on the whole row: opacity creates a compositing group
   the child cannot climb back out of, so a .5 here would drag the gold badge down with it
   and no rule on .nav-count could restore it. */
.nav-item.nav-soon { color: var(--text-muted); pointer-events: none; cursor: default; }
.nav-item.nav-soon:hover { background: none; }
.nav-item.nav-soon i { opacity: .5; }
.nav-count-soon { background: #f59e0b9c; color: #ffffff; font-size: 10px; letter-spacing: .04em; }
</style>

