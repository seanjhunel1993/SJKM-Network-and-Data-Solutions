<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="IrT5vTPqAVbkV7OP8qu1UCDMZT1E1Y17pxcG0vZ3">
    <title>Settings — SJKM NETWORK DATA LINK</title>
                <link rel="icon" href="https://sjkmdatalink.isproph.com/storage/company/sjkm-data-link-bUVlA3/favicon_1785149072.png">
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --primary: #e82626; --primary-dark: #2cc229; --primary-light: #818cf8;
            --sidebar-bg: #ffffff; --sidebar-text: #64748b; --sidebar-active: #e82626;
            --sidebar-hover-text: #1e293b; --sidebar-hover-bg: #f1f5f9;
            --sidebar-active-text: #e82626; --sidebar-active-bg: rgba(99,102,241,.1);
            --sidebar-border: #e2e8f0; --sidebar-name: #1e293b;
            --bg: #f1f5f9; --card-bg: #fff; --text: #1e293b; --text-muted: #64748b;
            --border: #e2e8f0; --success: #10b981; --warning: #f59e0b; --danger: #ef4444; --info: #3b82f6;
            --radius: 12px; --shadow: 0 1px 3px rgba(0,0,0,.08), 0 4px 12px rgba(0,0,0,.04);
        }
        html.dark {
            --bg: #0f172a; --card-bg: #1e293b; --text: #e6edf5; --text-muted: #94a3b8;
            --border: #334155;
            --shadow: 0 1px 3px rgba(0,0,0,.45), 0 4px 12px rgba(0,0,0,.35);
            --sidebar-bg: #0b1120; --sidebar-text: #94a3b8;
            --sidebar-hover-text: #ffffff; --sidebar-hover-bg: rgba(255,255,255,.06);
            --sidebar-active-text: #ffffff; --sidebar-active-bg: rgba(99,102,241,.2);
            --sidebar-border: rgba(255,255,255,.07); --sidebar-name: #ffffff;
        }
        html.dark .badge-secondary { background: #0f172a; color: #cbd5e1; border-color: #334155; }
        html.dark .form-control, html.dark input, html.dark select, html.dark textarea { background: var(--card-bg); color: var(--text); }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text); font-size: 14px; min-height: 100vh; display: flex; }
        a { color: var(--primary); text-decoration: none; }
        /* Sidebar */
        .sidebar { width: 260px; min-height: 100vh; background: var(--sidebar-bg); display: flex; flex-direction: column; flex-shrink: 0; position: fixed; top: 0; left: 0; height: 100vh; overflow-y: auto; z-index: 100; transition: transform .25s ease; }
        .sidebar { scrollbar-width: thin; scrollbar-color: rgba(148,163,184,.4) transparent; }
        .sidebar::-webkit-scrollbar { width: 5px; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(148,163,184,.4); border-radius: 5px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar-logo { padding: 15.5px 20px 15.5px 20px; border-bottom: 1px solid var(--sidebar-border); }
        .logo-wrap { display: flex; align-items: center; justify-content: center; gap: 10px; text-decoration: none; color: inherit; transition: opacity .15s; }
        .logo-wrap:hover { opacity: .85; }
        .logo-icon { height: 32px; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 18px; flex-shrink: 0; }
        .logo-img-dark { display: none; }
        html.dark .logo-img-light { display: none; }
        html.dark .logo-img-dark { display: block; }
        .logo-text { font-size: 16px; font-weight: 700; color: #fff; line-height: 1.2; }
        .logo-sub { font-size: 11px; color: var(--sidebar-text); font-weight: 400; }
        .sidebar-nav { flex: 1; padding: 12px 0; overflow-y: auto; }
        .nav-section-label { font-size: 10px; font-weight: 700; color: var(--sidebar-text); opacity: .65; text-transform: uppercase; letter-spacing: .08em; padding: 12px 20px 4px; }
        .nav-upgrade { display: flex; align-items: center; gap: 10px; margin: 12px; padding: 12px 14px; border-radius: 10px; background: linear-gradient(135deg,#6366f1,#8b5cf6); color: #fff; text-decoration: none; box-shadow: 0 4px 14px rgba(99,102,241,.35); transition: opacity .15s; }
        .nav-upgrade:hover { opacity: .92; }
        .nav-upgrade i { font-size: 18px; flex-shrink: 0; }
        .nav-upgrade-title { font-size: 13px; font-weight: 700; line-height: 1.2; }
        .nav-upgrade-sub { font-size: 11px; opacity: .85; line-height: 1.2; margin-top: 2px; }
        body.sidebar-collapsed .nav-upgrade { justify-content: center; padding: 12px 0; }
        body.sidebar-collapsed .nav-upgrade div { display: none; }
        .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 20px; color: var(--sidebar-text); font-size: 13.5px; font-weight: 500; transition: all .15s; cursor: pointer; border-radius: 0; position: relative; }
        .nav-item:hover { color: var(--sidebar-hover-text); background: var(--sidebar-hover-bg); }
        .nav-item.active { color: var(--sidebar-active-text); background: var(--sidebar-active-bg); }
        .nav-item.active::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); height: 60%; width: 3px; background: var(--primary); border-radius: 0 4px 4px 0; }
        .nav-item i { width: 18px; text-align: center; font-size: 14px; }
        .nav-badge { margin-left: auto; background: var(--primary); color: #fff; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 99px; }
        .sidebar-footer { padding: 16px 20px; border-top: 1px solid var(--sidebar-border); }
        .sidebar-credit { font-size: 11px; color: var(--sidebar-text); opacity: .8; text-align: center; line-height: 1.5; }
        .sidebar-credit strong { font-weight: 600; }
        .sidebar-credit-sep { opacity: .55; }
        .user-card { display: flex; align-items: center; gap: 10px; }
        .user-avatar { width: 36px; height: 36px; background: var(--primary); border-radius: 9px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 14px; font-weight: 700; flex-shrink: 0; }
        .user-info .user-name { font-size: 13px; font-weight: 600; color: var(--sidebar-name); }
        .user-info .user-role { font-size: 11px; color: var(--sidebar-text); }
        /* Main content */
        .main-content { margin-left: 260px; flex: 1; display: flex; flex-direction: column; min-height: 100vh; transition: margin-left .25s ease; }
        .topbar { background: var(--card-bg); border-bottom: 1px solid var(--border); padding: 0; height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 16px; position: sticky; top: 0; z-index: 50; box-shadow: 0 1px 4px rgba(0,0,0,.04); }
        .topbar-left { display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; overflow: hidden; }
        .topbar-title { flex: 1; min-width: 0; font-size: 20px; font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .topbar-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; padding: 0px 10px; }
        .topbar-btn { width: 36px; height: 36px; background: var(--bg); border: 1px solid var(--border); border-radius: 9px; display: flex; align-items: center; justify-content: center; color: var(--text-muted); cursor: pointer; position: relative; }
        .topbar-btn:hover { background: var(--border); }
        .topbar-user { display: flex; align-items: center; cursor: pointer; border-radius: 10px; }
        .topbar-user:hover { background: var(--bg); }
        .topbar-user-name { margin-right: 8px; font-size: 13px; font-weight: 600; color: var(--text); }
        .topbar-user-role { font-size: 11px; color: var(--text-muted); }
        .topbar-avatar { width: 34px; height: 34px; background: var(--primary); border-radius: 9px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 13px; font-weight: 700; }
        /* Page content */
        .page-content { padding: 24px; flex: 1; }
        .page-header { margin-bottom: 24px; }
        .page-header h1 { font-size: 22px; font-weight: 700; color: var(--text); }
        .breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-muted); margin-top: 4px; }
        .breadcrumb a { color: var(--text-muted); }
        .breadcrumb a:hover { color: var(--primary); }
        .breadcrumb .sep { color: var(--border); }
        /* Cards */
        .card { background: var(--card-bg); border-radius: 5px; border: 1px solid var(--border); box-shadow: var(--shadow); overflow: hidden; }
        .card-header { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .card-title { font-size: 15px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 8px; }
        .card-body { padding: 20px; }
        /* Stat cards */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
        .stat-card { background: var(--card-bg); border-radius: 5px; border: 1px solid var(--border); padding: 20px; display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; box-shadow: var(--shadow); }
        .stat-info .stat-label { font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: capitalize; letter-spacing: .05em; margin-bottom: 6px; }
        .stat-info .stat-value { font-size: 22px; line-height: 1; }
        .stat-info .stat-change { font-size: 12px; color: var(--success); margin-top: 4px; }
        .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
        /* Tables */
        .table-wrapper { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; padding: 10px 16px; background: var(--bg); border-bottom: 1px solid var(--border); text-align: left; }
        td { padding: 12px 16px; border-bottom: 1px solid var(--border); font-size: 13.5px; color: var(--text); }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: rgba(99,102,241,.02); }
        /* Badges */
        .badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 99px; font-size: 11px; font-weight: 600; }
        .badge-success { background: #d1fae5; color: #065f46; }
        .badge-warning { background: #fef3c7; color: #92400e; }
        .badge-danger { background: #fee2e2; color: #991b1b; }
        .badge-info { background: #dbeafe; color: #1e40af; }
        .badge-secondary { background: var(--bg); color: var(--text-muted); border: 1px solid var(--border); }
        /* Buttons */
        .btn { display: inline-flex; align-items: center; gap: 7px; padding: 9px 16px; border-radius: 9px; font-size: 13.5px; font-weight: 600; cursor: pointer; border: none; font-family: 'Plus Jakarta Sans', sans-serif; transition: all .15s; }
        .btn-primary { background: var(--primary); color: #fff; }
        .btn-primary:hover { background: var(--primary-dark); }
        .btn-secondary { background: var(--bg); color: var(--text); border: 1px solid var(--border); }
        .btn-secondary:hover { background: var(--border); }
        .btn-success { background: var(--success); color: #fff; }
        .btn-danger { background: var(--danger); color: #fff; }
        .btn-sm { padding: 5px 10px; font-size: 12px; border-radius: 7px; }
        /* Forms */
        .form-group { margin-bottom: 16px; }
        .form-label { display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
        .form-control { width: 100%; padding: 7px 14px; border: 1.5px solid var(--border); border-radius: 9px; font-size: 14px; font-family: 'Plus Jakarta Sans', sans-serif; color: var(--text); background: var(--card-bg); outline: none; transition: all .15s; }
        .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(99,102,241,.1); }
        .form-control.error { border-color: var(--danger); }
        .form-error { color: var(--danger); font-size: 12px; margin-top: 4px; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .form-hint { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
        /* Alerts */
        .alert { padding: 12px 16px; border-radius: 9px; font-size: 13.5px; margin-bottom: 16px; display: flex; align-items: center; gap: 10px; }
        .alert-success { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }
        .alert-danger { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
        .alert-warning { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
        /* Pagination */
        .pagination { display: flex; align-items: center; gap: 6px; padding: 16px 20px; border-top: 1px solid var(--border); }
        .page-link { padding: 6px 12px; border-radius: 7px; border: 1px solid var(--border); color: var(--text-muted); font-size: 13px; font-weight: 500; }
        .page-link:hover { background: var(--bg); color: var(--primary); }
        .page-link.active { background: var(--primary); color: #fff; border-color: var(--primary); }
        /* Charts */
        .chart-container { position: relative; }
        /* Grids */
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
        /* Avatar initials */
        .avatar { width: 36px; height: 36px; border-radius: 9px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 13px; font-weight: 700; flex-shrink: 0; }
        /* Actions dropdown */
        .actions { display: flex; align-items: center; gap: 6px; }
        /* Search bar */
        .search-bar { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
        /* Search box: the wrapper is the bordered field; the icon + input are flex
           children inside it, so the icon can never fall outside the box. */
        .search-input-wrap { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 200px; padding: 9px 14px; border: 1.5px solid var(--border); border-radius: 9px; background: var(--card-bg); }
        .search-input-wrap:focus-within { border-color: var(--primary); }
        .search-input-wrap i { color: var(--text-muted); flex-shrink: 0; font-size: 13px; }
        .search-input-wrap input { flex: 1; min-width: 0; border: none; outline: none; padding: 0; margin: 0; background: transparent; font-size: 13.5px; font-family: 'Plus Jakarta Sans', sans-serif; color: var(--text); }
        .search-input-wrap input:focus { border-color: var(--primary); }
        select.form-control { cursor: pointer; }
        /* Sidebar overlay (mobile) */
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 99; }
        /* Hamburger */
        .hamburger { display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; border: 1.5px solid var(--border); border-radius: 9px; background: var(--card-bg); cursor: pointer; color: var(--text); flex-shrink: 0; }
        /* Desktop: no border / radius on the hamburger */
        @media (min-width: 769px) { .hamburger { border: none; border-radius: 0; } }
        /* Desktop collapse (toggled by hamburger) */
        body.sidebar-collapsed .sidebar { transform: translateX(-100%); }
        body.sidebar-collapsed .main-content { margin-left: 0; }
        /* Responsive */
        @media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); transition: transform .25s ease; }
            .sidebar.open { transform: translateX(0); }
            .sidebar-overlay.open { display: block; }
            .main-content { margin-left: 0; }
            .hamburger { display: flex; }
            .form-row { grid-template-columns: 1fr; }
            .grid-2, .grid-3 { grid-template-columns: 1fr; }
            .stats-grid { grid-template-columns: 1fr 1fr; }
            .page-content { padding: 16px; }
            .topbar { padding: 0 16px; }
            .topbar-user-name, .topbar-user-role { display: none; }
            .topbar-title { font-size: 17px; }
            /* Page header — stack title row and action button(s) */
            .page-header { flex-wrap: wrap !important; gap: 12px !important; }
            /* Card header — allow content to wrap */
            .card-header { flex-wrap: wrap; gap: 8px; }
            /* Search bars — stack inputs vertically */
            .search-bar { flex-direction: column; align-items: stretch; }
            .search-bar .search-input-wrap { width: 100%; min-width: 0; }
            .search-bar select.form-control { width: 100% !important; }
            .search-bar .btn { align-self: flex-start; }
            /* Tables — smooth touch scroll on iOS */
            .table-wrapper { -webkit-overflow-scrolling: touch; }
            /* Action button groups — allow wrap */
            .actions { flex-wrap: wrap; }
            /* Compact stat cards */
            .stat-card { padding: 14px; }
            .stat-info .stat-value { font-size: 22px; }
            .stat-icon { width: 40px; height: 40px; font-size: 16px; }
        }
        @media (max-width: 480px) {
            .stats-grid { grid-template-columns: 1fr; }
            .page-header h1 { font-size: 18px; }
            /* Dashboard donut chart + legend — stack vertically */
            .chart-legend-row { flex-direction: column !important; align-items: center !important; }
            .chart-legend-items { margin-left: 0 !important; margin-top: 16px; }
        }
    </style>
    <style>
.settings-layout-grid { display: grid; grid-template-columns: 220px 1fr; gap: 20px; align-items: start; }
/* Let the content column shrink so wide children (e.g. the router script) scroll inside their box instead of stretching the page. */
.settings-layout-grid > * { min-width: 0; }
#billing-script { max-width: 100%; overflow-x: auto; }
@media (max-width: 768px) { .settings-layout-grid { grid-template-columns: 1fr; } .settings-sticky-nav { position: static !important; } }
.settings-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    transition: all .15s;
    border-left: 3px solid transparent;
    text-decoration: none;
}
.settings-nav-item:hover { color: var(--text); background: var(--bg); }
.settings-nav-item.active { color: var(--primary); background: rgba(99,102,241,.06); border-left-color: var(--primary); font-weight: 600; }
.settings-nav-item i { width: 16px; text-align: center; font-size: 13px; }
.alert { padding: 12px 16px; border-radius: 10px; font-size: 13px; display: flex; align-items: center; gap: 8px; }
.alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
/* Modal */
.modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 1000; align-items: center; justify-content: center; padding: 20px; overflow-y: auto; }
.modal-overlay.open { display: flex; }
.modal-box { background: var(--card-bg); border-radius: 12px; max-width: 460px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,.3); overflow: hidden; margin: auto; }
.modal-head { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.modal-body { padding: 20px; }
.modal-foot { padding: 14px 20px; border-top: 1px solid var(--border); display: flex; gap: 10px; justify-content: flex-end; }
/* Banks table — mobile expandable rows */
.bank-table .bank-toggle-col { display: none; }
.bank-table .bank-detail { display: none; }
.bank-toggle-btn { width: 30px; height: 30px; padding: 0; border-radius: 7px; border: 1px solid var(--border); background: var(--card-bg); color: var(--text); cursor: pointer; font-size: 13px; line-height: 1; display: inline-flex; align-items: center; justify-content: center; }
.bank-toggle-btn:hover { background: var(--bg); }
.bank-detail-grid { display: grid; grid-template-columns: auto 1fr; gap: 8px 16px; margin: 0; padding: 14px 16px; font-size: 13px; }
.bank-detail-grid dt { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); align-self: center; }
.bank-detail-grid dd { margin: 0; color: var(--text); }
@media (max-width: 768px) {
    .bank-table .bank-toggle-col { display: table-cell; }
    .bank-table .col-hide-mobile { display: none; }
    .bank-table tr.bank-row.expanded + .bank-detail { display: table-row; }
    .bank-table tr.bank-detail > td { background: var(--bg); padding: 0; }
    .bank-table tr.bank-row.expanded td { border-bottom: none; }
}
/* Employees table — mobile expandable rows */
.emp-table .emp-toggle-col { display: none; }
.emp-table .emp-detail { display: none; }
.emp-toggle-btn { width: 30px; height: 30px; padding: 0; border-radius: 7px; border: 1px solid var(--border); background: var(--card-bg); color: var(--text); cursor: pointer; font-size: 13px; line-height: 1; display: inline-flex; align-items: center; justify-content: center; }
.emp-toggle-btn:hover { background: var(--bg); }
.emp-detail-grid { display: grid; grid-template-columns: auto 1fr; gap: 8px 16px; margin: 0; padding: 14px 16px; font-size: 13px; }
.emp-detail-grid dt { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); align-self: center; }
.emp-detail-grid dd { margin: 0; color: var(--text); }
@media (max-width: 768px) {
    .emp-table .emp-toggle-col { display: table-cell; }
    .emp-table .col-hide-mobile { display: none; }
    .emp-table tr.emp-row.expanded + .emp-detail { display: table-row; }
    .emp-table tr.emp-detail > td { background: var(--bg); padding: 0; }
    .emp-table tr.emp-row.expanded td { border-bottom: none; }
}
/* Row action (hamburger) dropdown menu */
.row-menu { position: relative; display: inline-block; }
.row-menu-dropdown { display: none; position: fixed; min-width: 160px; background: var(--card-bg); border: 1px solid var(--border); border-radius: 10px; box-shadow: 0 8px 28px rgba(0,0,0,.16); padding: 6px; z-index: 1600; }
.row-menu-dropdown.open { display: block; }
.row-menu-dropdown form { margin: 0; }
.row-menu-item { display: flex; align-items: center; gap: 10px; width: 100%; padding: 9px 12px; font-size: 13px; font-weight: 500; color: var(--text); background: none; border: none; border-radius: 7px; cursor: pointer; text-align: left; font-family: inherit; }
.row-menu-item:hover { background: var(--bg); }
.row-menu-item.danger { color: var(--danger); }
.row-menu-item.danger:hover { background: #fee2e2; }
.row-menu-item i { width: 15px; text-align: center; }
</style>
</head>
<body>
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
